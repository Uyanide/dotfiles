#!/usr/bin/env bash

set -euo pipefail

if ! [ -t 1 ] || ! { : </dev/tty; } 2>/dev/null; then
    exit 1
fi

# Increase timeout for SSH sessions
TIMEOUT=1
[[ -n "${SSH_CONNECTION:-}" ]] && TIMEOUT=3

exec 3<>/dev/tty

# Construct query
ITERM2_QUERY_CODE=$(printf "\033]1337;ReportCellSize\a")
ITERM2_EXPECTED_RESPONSE=$(printf "\033]1337;") # followed by "ReportCellSize=...", but only the prefix is enough
FENCE_CODE=$(printf "\033[c")
FENCE_RESPONSE_RE=$'\033\\[\\?([0-9;]*)c'

# Set terminal to raw mode with timeout
stty_orig=$(stty -g <&3)
trap 'stty "$stty_orig" <&3' EXIT
trap 'exit 130' INT TERM HUP
stty -echo -icanon min 1 time 0 <&3

printf "%s%s%s" "$ITERM2_QUERY_CODE" "$FENCE_CODE" >&3

support_iterm2=0

response=""
while [ ${#response} -le 1024 ]; do
    IFS= read -r -n 1 -d '' -t "$TIMEOUT" -u 3 char || break

    response+="$char"

    if [[ "$response" =~ $FENCE_RESPONSE_RE ]]; then
        break
    fi
done

if [[ "$response" == *"$ITERM2_EXPECTED_RESPONSE"* ]]; then
    support_iterm2=1
fi

# Terminals that don't parse APC print the query as text
printf "\r\033[K" >&3

[[ $support_iterm2 -eq 1 ]]
