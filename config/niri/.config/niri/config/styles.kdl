layout {
    gaps 0

    center-focused-column "never"

    preset-column-widths {
        proportion 0.3
        proportion 0.5
        proportion 0.7
    }

    preset-window-heights {
        proportion 0.5
        proportion 0.75
        proportion 1.0
    }

    default-column-width { proportion 0.7; }

    focus-ring {
        width 2
        active-color "#89b4fa"
        inactive-color "#1e1e2e"
    }

    border {
        off
    }

    shadow {
        on

        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        top 2
        right 2
        bottom 3
        left 2
    }

    background-color "transparent"
}

overview {
    backdrop-color "#1e1e2e"

    workspace-shadow {
        off
    }
}

// Disable the "Important Hotkeys" pop-up at startup.
hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

animations {
    // off
    // slowdown 3.0
    
    workspace-switch {
       duration-ms 300
       curve "ease-out-cubic"
    }
}

layer-rule {
    match namespace="backdrop$"
    place-within-backdrop true

}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-when-typing
}

// I love rounded corners
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

recent-windows {
    highlight {
        active-color "#89b4fa"
        urgent-color "#f38ba8"
        corner-radius 14
    }
}
